# Lego configuration. Every value can also be set as a plain environment
# variable (Dokploy, docker compose, CI); a .env file is optional.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lego
DB_USERNAME=lego
# Required. Use a long random value, e.g. `openssl rand -hex 24`.
DB_PASSWORD=

# Run pending migrations when the app container starts.
LEGO_MIGRATE_ON_START=true

# Host port for compose.local.yml.
LEGO_HTTP_PORT=8080

# First administrator, created on start when no user exists (idempotent).
# Leave LEGO_ADMIN_PASSWORD empty to generate one; it is printed once in the
# app container log. Or run `php lego install --email=...` by hand.
LEGO_ADMIN_EMAIL=
LEGO_ADMIN_PASSWORD=

# AI assistants (doc/ia.md): off, read (read-only actions) or write (plus
# modules with #[Module(agentWrites: true)]). Also sets Permissions-Policy tools.
LEGO_AGENT_ACCESS=off

# Sessions: idle lifetime in minutes and absolute lifetime in days.
LEGO_SESSION_IDLE_MINUTES=480
LEGO_SESSION_ABSOLUTE_DAYS=30
